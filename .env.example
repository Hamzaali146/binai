# CV Testing Framework — Environment Variables
# Copy this file to .env and fill in your values.

# Application
APP_NAME="CV Testing Framework"
APP_VERSION="1.0.0"
DEBUG=false

# Database — use PostgreSQL in production
DATABASE_URL=sqlite:///./data/cv_testing.db
# DATABASE_URL=postgresql://user:password@localhost:5432/cv_testing

# CORS — add your frontend origins
CORS_ORIGINS=["http://localhost:8501","http://localhost:3000"]

# Evaluation defaults
DEFAULT_CONFIDENCE_THRESHOLD=0.5
DEFAULT_IOU_THRESHOLD=0.5
MAX_FAILURE_IMAGES=100

# API server
API_HOST=0.0.0.0
API_PORT=8000
