dist/
build/
*.egg-info/
*.egg
MANIFEST
wheels/
pip-wheel-metadata/
share/python-wheels/
.installed.cfg

# ── Environment variables ─────────────────────────────────────────────────────
.env
*.env.local

# ── Database ──────────────────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
data/cv_testing.db

# ── Generated data (keep folder structure, ignore contents) ──────────────────
data/datasets/
data/results/
data/reports/
data/failures/
!data/.gitkeep
!data/datasets/.gitkeep
!data/results/.gitkeep
!data/reports/.gitkeep
!data/failures/.gitkeep

